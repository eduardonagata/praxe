---
/**
 * A grade do curso. Todos os tópicos ficam visíveis no HTML — nada escondido
 * atrás de acordeão ou de clique, para que o buscador leia a grade inteira.
 */
import {
  publicoAlvo,
  resultadosDeAprendizagem,
  modulos,
  preRequisitos,
  cicloDeTrabalho,
} from '../data/conteudo';
import Seta from './Seta.astro';
---

<section class="section" id="a-grade" aria-labelledby="titulo-grade">
  <div class="wrap">
    <p class="eyebrow">A grade</p>
    <h2 id="titulo-grade">O que você aprende, módulo a módulo</h2>

    <!-- O ciclo que o curso ensina, do pedido ao documento assinado. -->
    <ol class="ciclo" aria-label="O ciclo de trabalho do método">
      {
        cicloDeTrabalho.map((passo, i) => (
          <li class="passo">
            <div class="caixa">
              <span class="caixa__rotulo mono">{passo.rotulo}</span>
              <p class="caixa__titulo">{passo.titulo}</p>
              <p class="caixa__detalhe">{passo.detalhe}</p>
            </div>
            {i < cicloDeTrabalho.length - 1 && (
              <span class="seta-h">
                <Seta variante="curta" largura="58px" cor="var(--ink-2)" />
              </span>
            )}
          </li>
        ))
      }
    </ol>

    <div class="colunas">
      <div class="sketch bloco">
        <h3>Para quem é</h3>
        <p>{publicoAlvo}</p>
      </div>

      <div class="sketch bloco">
        <h3>Ao final, você é capaz de</h3>
        <ul class="list-check">
          {resultadosDeAprendizagem.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>

    <h3 class="subtitulo">O programa, em 6 módulos</h3>

    <ol class="modulos">
      {
        modulos.map((modulo) => (
          <li class="modulo">
            <div class="modulo__cabeca">
              <span class="modulo__numero" aria-hidden="true">
                {String(modulo.numero).padStart(2, '0')}
              </span>
              <h4 class="modulo__titulo">
                <span class="visually-hidden">Módulo {modulo.numero}: </span>
                {modulo.titulo}
              </h4>
            </div>
            <p class="modulo__objetivo">{modulo.objetivo}</p>
            <ul class="list-dash">
              {modulo.topicos.map((topico) => <li>{topico}</li>)}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="rodape-grade">
      <div class="sketch bloco">
        <h3>Pré-requisitos</h3>
        <ul class="list-dash">
          {preRequisitos.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="bloco">
        <h3>Carga horária</h3>
        <p class="muted">
          De 8 a 12 horas de conteúdo gravado, com exercícios práticos sobre documentos
          reais. Acesso vitalício, no seu ritmo.
        </p>
        <p class="hand carga">Um curso só, do começo ao documento assinado.</p>
      </div>
    </div>

  </div>
</section>

<style>
  /* ---------------- Ciclo ---------------- */

  .ciclo {
    list-style: none;
    margin: 0 0 clamp(2.5rem, 1.5rem + 3vw, 3.5rem);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.9rem;
  }

  .passo {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex: 1 1 15rem;
  }

  .caixa {
    flex: 1;
    align-self: stretch;
    background: var(--note);
    border: 2px solid var(--ink);
    padding: 0.85rem 1rem 1rem;
    box-shadow: 3px 4px 0 rgba(34, 31, 27, 0.1);
    transform: rotate(-0.7deg);
  }

  .passo:nth-child(2n) .caixa {
    transform: rotate(0.8deg);
    background: var(--note-deep);
  }

  .caixa__rotulo {
    display: block;
    color: rgba(34, 31, 27, 0.55);
    margin-bottom: 0.15rem;
  }

  .caixa__titulo {
    margin: 0 0 0.3rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .caixa__detalhe {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.4;
    color: rgba(34, 31, 27, 0.75);
  }

  .seta-h {
    display: block;
    flex: none;
  }

  @media (max-width: 46rem) {
    .ciclo {
      flex-direction: column;
      align-items: stretch;
    }
    .passo {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .passo .caixa {
      width: 100%;
    }
    .seta-h {
      transform: rotate(90deg);
      margin-left: 2rem;
    }
  }

  /* ---------------- Blocos ---------------- */

  .colunas {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 3.5rem);
  }

  @media (min-width: 52rem) {
    .colunas {
      grid-template-columns: 1fr 1.2fr;
      align-items: start;
    }
  }

  .bloco h3 {
    margin-top: 0;
    font-size: 1.15rem;
  }

  .bloco p:last-child {
    margin-bottom: 0;
  }

  .subtitulo {
    font-family: var(--hand);
    font-size: 2rem;
    color: var(--ink-2);
    transform: rotate(-0.6deg);
    transform-origin: left;
    margin-bottom: 1.4rem;
  }

  /* ---------------- Módulos ---------------- */

  .modulos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 54rem) {
    .modulos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .modulo {
    background: rgba(255, 255, 255, 0.55);
    border: 2px solid var(--ink);
    border-radius: 3px;
    padding: 1.4rem 1.5rem 1.6rem;
    position: relative;
  }

  .modulo::after {
    content: '';
    position: absolute;
    inset: 5px 4px 6px 5px;
    border: 1px solid var(--pencil);
    opacity: 0.4;
    pointer-events: none;
  }

  .modulo:nth-child(odd) {
    transform: rotate(-0.3deg);
  }

  .modulo:nth-child(even) {
    transform: rotate(0.3deg);
  }

  .modulo__cabeca {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 0.5rem;
  }

  .modulo__numero {
    font-family: var(--hand);
    font-size: 2.1rem;
    line-height: 1;
    color: var(--accent);
  }

  .modulo__titulo {
    margin: 0;
    font-size: 1.18rem;
    line-height: 1.2;
  }

  .modulo__objetivo {
    margin: 0 0 0.9rem;
    color: var(--ink-3);
    font-size: 0.97em;
    font-style: italic;
  }

  /* ---------------- Rodapé da grade ---------------- */

  .rodape-grade {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 52rem) {
    .rodape-grade {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
    }
  }

  .carga {
    color: var(--accent);
    margin-top: 1rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
