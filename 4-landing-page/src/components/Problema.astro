---
/**
 * O problema. É a seção mais densa em texto — e a que mais trabalha pelo SEO:
 * descreve, com as palavras de quem vive o problema, exatamente o que a pessoa
 * digitaria em uma busca.
 */
import {
  apresentacao,
  etapasDoProblema,
  fechamentoDoProblema,
  frase,
} from '../data/conteudo';
---

<section class="section" id="o-problema" aria-labelledby="titulo-problema">
  <div class="wrap">
    <p class="eyebrow">O problema</p>
    <h2 id="titulo-problema">Trabalho documental dentro de uma interface feita para conversar</h2>

    <div class="intro">
      {apresentacao.map((paragrafo) => <p>{paragrafo}</p>)}
    </div>

    <p class="chamada">
      Tenho certeza de que você já se viu em um fluxo de trabalho parecido com este:
    </p>

    <ol class="fluxo">
      {
        etapasDoProblema.map((etapa) => (
          <li>
            <p class="etapa__texto">{etapa.texto}</p>
            {etapa.margem && <p class="etapa__margem hand">{etapa.margem}</p>}
          </li>
        ))
      }
    </ol>

    <hr class="rule" />

    <div class="fechamento">
      {fechamentoDoProblema.map((paragrafo) => <p>{paragrafo}</p>)}
    </div>

    <p class="frase">{frase}</p>

    <p class="pergunta-final hand">Então qual seria a alternativa?</p>
  </div>
</section>

<style>
  .intro,
  .fechamento {
    max-width: 46rem;
  }

  .intro p:first-child {
    font-size: 1.1em;
    color: var(--ink-2);
  }

  .chamada {
    max-width: 46rem;
    margin-top: 2.5rem;
    font-weight: 600;
  }

  /* Lista numerada como um bloco de anotações: filete a lápis à esquerda,
     números escritos à mão e observações na margem. */
  .fluxo {
    list-style: none;
    counter-reset: etapa;
    margin: 1.5rem 0 0;
    --trilho: clamp(2.2rem, 1rem + 4vw, 3.2rem);
    padding: 0 0 0 var(--trilho);
    position: relative;
    border-left: 2px solid var(--line);
  }

  .fluxo::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--line);
    opacity: 0.55;
  }

  .fluxo li {
    counter-increment: etapa;
    position: relative;
    display: grid;
    gap: 0.35rem 1.5rem;
    padding-block: 0.85rem;
    max-width: 60rem;
  }

  .fluxo li + li {
    border-top: 1px dashed rgba(34, 31, 27, 0.14);
  }

  .fluxo li::before {
    content: counter(etapa);
    position: absolute;
    left: calc(var(--trilho) * -1 + 0.15rem);
    top: 0.8rem;
    width: 1.9rem;
    text-align: center;
    font-family: var(--hand);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--accent);
  }

  .etapa__texto {
    margin: 0;
    color: var(--ink-2);
  }

  .etapa__margem {
    margin: 0;
    color: var(--ink-3);
    align-self: start;
    position: relative;
    padding-left: 1.5rem;
  }

  .etapa__margem::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 1rem;
    height: 1px;
    background: var(--pencil);
  }

  @media (min-width: 70rem) {
    .fluxo li {
      grid-template-columns: minmax(0, 46rem) 14rem;
      align-items: start;
    }
  }

  .frase {
    max-width: 34ch;
    margin: 2.5rem 0 1.5rem;
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.25rem);
    line-height: 1.22;
    font-weight: 600;
    letter-spacing: -0.02em;
    position: relative;
    padding-left: 1.5rem;
    border-left: 4px solid var(--accent);
  }

  .pergunta-final {
    font-size: 1.9rem;
    color: var(--accent);
    transform: rotate(-1.4deg);
    transform-origin: left;
    margin: 0;
  }
</style>
