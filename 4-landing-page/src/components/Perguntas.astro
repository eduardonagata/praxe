---
/**
 * Perguntas frequentes. Usa <details>, que não depende de JavaScript: o texto
 * das respostas está no HTML entregue ao rastreador mesmo quando recolhido,
 * e as mesmas perguntas alimentam o bloco FAQPage do JSON-LD.
 */
import { faq } from '../data/conteudo';
---

<section class="section" id="perguntas" aria-labelledby="titulo-faq">
  <div class="wrap wrap--narrow">
    <p class="eyebrow">Antes de decidir</p>
    <h2 id="titulo-faq">Perguntas frequentes</h2>

    <div class="lista">
      {
        faq.map((item, i) => (
          <details class="item" open={i === 0}>
            <summary>
              <h3>{item.pergunta}</h3>
            </summary>
            <p>{item.resposta}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .lista {
    margin-top: 1.5rem;
    border-top: 1px dashed rgba(34, 31, 27, 0.25);
  }

  .item {
    border-bottom: 1px dashed rgba(34, 31, 27, 0.25);
    padding-block: 0.35rem;
  }

  summary {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    cursor: pointer;
    list-style: none;
    padding-block: 0.85rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::before {
    content: '+';
    font-family: var(--hand);
    font-size: 1.7rem;
    line-height: 1;
    color: var(--accent);
    flex: none;
    width: 1rem;
  }

  .item[open] summary::before {
    content: '–';
  }

  summary h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  summary:hover h3 {
    color: var(--accent);
  }

  .item p {
    margin: 0 0 1.1rem;
    padding-left: 1.75rem;
    color: var(--ink-2);
    max-width: 60ch;
  }
</style>
