---
/**
 * Seção de vídeos: cada aula com o título acima da moldura. Cada vídeo com
 * `embedUrl` vazio em src/config/site.ts exibe uma moldura de espaço reservado.
 *
 * O player do YouTube só é carregado no clique. Até lá, a moldura mostra a
 * miniatura do vídeo: cada player pesa perto de 1 MB de script, e a seção fica
 * logo abaixo da abertura, onde `loading="lazy"` não adiaria nada.
 */
import { videos, idDoYoutube } from '../config/site';
---

<section class="section section--sheet" id="o-video" aria-label="Aulas em vídeo">
  <div class="wrap">
    <div class="lista">
      {
        videos.map((video, i) => (
          <div class={i % 2 ? 'conteudo conteudo--invertido' : 'conteudo'}>
            <h2>{video.titulo}</h2>
            <div class="moldura">
              {video.embedUrl ? (
                <a
                  class="capa"
                  href={`https://www.youtube.com/watch?v=${idDoYoutube(video.embedUrl)}`}
                  data-video={idDoYoutube(video.embedUrl)}
                  data-titulo={video.titulo}
                  aria-label={`Reproduzir o vídeo: ${video.titulo}`}
                >
                  <picture>
                    <source
                      type="image/webp"
                      srcset={`https://i.ytimg.com/vi_webp/${idDoYoutube(video.embedUrl)}/maxresdefault.webp`}
                    />
                    <img
                      src={`https://i.ytimg.com/vi/${idDoYoutube(video.embedUrl)}/maxresdefault.jpg`}
                      alt=""
                      width="1280"
                      height="720"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                  <span class="play" aria-hidden="true" />
                </a>
              ) : (
                <div class="reserva">
                  <span class="play" aria-hidden="true" />
                  <p class="hand">vídeo em breve</p>
                  {import.meta.env.DEV && (
                    <p class="mono dica">
                      cole a URL de incorporação em <code>src/config/site.ts → videos[{i}].embedUrl</code>
                    </p>
                  )}
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Sem JavaScript, a capa continua sendo um link para o vídeo no YouTube.
  let conectado = false;

  function preconectar() {
    if (conectado) return;
    conectado = true;
    for (const href of ['https://www.youtube-nocookie.com', 'https://www.google.com']) {
      const link = document.createElement('link');
      link.rel = 'preconnect';
      link.href = href;
      document.head.append(link);
    }
  }

  document.querySelectorAll<HTMLAnchorElement>('a.capa[data-video]').forEach((capa) => {
    capa.addEventListener('pointerover', preconectar, { once: true });
    capa.addEventListener('focus', preconectar, { once: true });
    capa.addEventListener('click', (evento) => {
      evento.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${capa.dataset.video}?autoplay=1&playsinline=1&rel=0`;
      iframe.title = capa.dataset.titulo ?? '';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      capa.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .conteudo {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  /* Título de aula, não de seção: menor que o h2 padrão. */
  .conteudo h2 {
    margin: 0;
    font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.7rem);
  }

  /* As aulas uma sobre a outra, cada moldura na largura toda do conteúdo. */
  .lista {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
  }

  /* Alterna a inclinação das molduras. */
  .conteudo--invertido .moldura {
    transform: rotate(0.4deg);
  }

  .moldura {
    position: relative;
    border: 2px solid var(--ink);
    border-radius: 3px;
    background: var(--paper-deep);
    padding: 0.55rem;
    transform: rotate(-0.4deg);
    box-shadow: 4px 5px 0 rgba(34, 31, 27, 0.12);
  }

  .moldura::after {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid var(--pencil);
    opacity: 0.45;
    pointer-events: none;
  }

  .moldura :global(iframe),
  .capa,
  .reserva {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    background: rgba(34, 31, 27, 0.06);
  }

  .capa {
    position: relative;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  /* Fora do fluxo, para a grade ter uma célula só e o play ficar no centro. */
  .capa picture {
    position: absolute;
    inset: 0;
  }

  .capa img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .capa .play {
    background: var(--paper-soft);
    opacity: 0.92;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  /* Moldura grande, botão proporcional. */
  @media (min-width: 48rem) {
    .capa .play {
      scale: 1.4;
    }
  }

  .capa:hover .play,
  .capa:focus-visible .play {
    opacity: 1;
    transform: scale(1.08);
  }

  .reserva {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.35rem;
    text-align: center;
    padding: 1rem;
  }

  .play {
    width: 3.5rem;
    height: 3.5rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    position: relative;
    opacity: 0.65;
  }

  .play::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    border-left: 1.1rem solid var(--ink);
    border-top: 0.7rem solid transparent;
    border-bottom: 0.7rem solid transparent;
  }

  .dica {
    color: var(--ink-3);
    max-width: 30ch;
  }

  .dica code {
    background: rgba(34, 31, 27, 0.07);
    padding: 0.1em 0.35em;
  }
</style>
