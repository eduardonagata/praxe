---
/**
 * Setas desenhadas à mão — traço trêmulo, ponta aberta, como as do quadro
 * de planejamento. Puramente decorativas: ficam fora da árvore de acessibilidade.
 *
 * Largura, cor e rotação vêm por propriedade e são aplicadas em estilo inline.
 * Estilo com escopo do componente pai não atravessa até este SVG, e sem largura
 * explícita o SVG se estica até a largura disponível.
 */
interface Props {
  variante?: 'baixo' | 'curva' | 'cotovelo' | 'curta' | 'chave';
  /** Largura final da seta, com unidade. A altura segue a proporção do traço. */
  largura?: string;
  cor?: string;
  /** Rotação em graus. A seta aponta para a direita (ou para baixo) por padrão. */
  rotacao?: number;
}

const {
  variante = 'baixo',
  largura = '80px',
  cor = 'var(--ink)',
  rotacao = 0,
} = Astro.props;

const desenhos = {
  baixo: {
    viewBox: '0 0 28 104',
    d: 'M13.5 3c-1.6 14 1.4 27-.8 41-1.1 7-.4 14.2.6 21.4.9 6.2 1.1 12.4.7 30',
    ponta: 'M6 79.5c3.1 6.4 5.6 12.6 8 21 2.2-8.6 4.5-15 7.6-21.6',
  },
  curva: {
    viewBox: '0 0 180 64',
    d: 'M4 14c26-8 52 2 76 14 16 8 33 16 62 18',
    ponta: 'M126 34c4.6 5.2 9.6 9.4 16.5 12.6-6.4 3.2-11 7.4-14.7 13.4',
  },
  cotovelo: {
    viewBox: '0 0 160 90',
    d: 'M6 6c1.4 22 .2 40 1 52.5.4 6 3 10 9.5 11.4 20 4.4 82 3 122 2.6',
    ponta: 'M126 62c6.2 3.4 12.4 6.2 21 8.4-8.6 2.4-14.6 5.4-20.6 9.6',
  },
  curta: {
    viewBox: '0 0 96 26',
    d: 'M3 13.5c18-3 40-2.4 78-1.2',
    ponta: 'M66 4.5c5.4 3.4 10.6 6 18 8.4-7.2 2.6-12.4 5.2-17.4 9',
  },
  chave: {
    viewBox: '0 0 26 120',
    d: 'M20 3C10 5 14 22 12 30c-1.6 6.6-5.6 8.6-9 10.2 3.6 1.6 7.6 3.6 9.2 10.4 1.8 8-2 25 8 27',
    ponta: '',
  },
} as const;

const { viewBox, d, ponta } = desenhos[variante];
const [, , largoBase, altoBase] = viewBox.split(' ').map(Number);

const estilo = [
  `width:${largura}`,
  `aspect-ratio:${largoBase}/${altoBase}`,
  `color:${cor}`,
  rotacao ? `transform:rotate(${rotacao}deg)` : '',
]
  .filter(Boolean)
  .join(';');
---

<svg
  class="seta"
  style={estilo}
  viewBox={viewBox}
  fill="none"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid meet"
>
  <path d={d} stroke="currentColor" stroke-width="2.1" stroke-linecap="round" />
  {
    ponta && (
      <path
        d={ponta}
        stroke="currentColor"
        stroke-width="2.1"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    )
  }
</svg>

<style>
  .seta {
    display: block;
    height: auto;
    flex: none;
    opacity: 0.75;
    overflow: visible;
  }
</style>
