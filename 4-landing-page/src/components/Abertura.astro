---
/**
 * Primeira dobra. À esquerda o argumento em texto (o que o buscador indexa);
 * à direita a ideia em imagem: o prompt escrito à mão vira documento formal,
 * e a comparação de versões mostra o que mudou.
 */
import { curso, acoes } from '../config/site';
import Seta from './Seta.astro';
---

<section class="abertura" id="topo">
  <div class="wrap grade">
    <div class="argumento">
      <p class="eyebrow">Curso online · método, não ferramenta</p>

      <h1>{curso.titulo}</h1>

      <p class="lead">{curso.subtitulo}</p>

      <p class="para-quem">
        Para quem passa o dia redigindo <span class="mark">ETPs, pareceres, termos de
        referência, relatórios e ofícios</span> — e sente que a IA deveria ajudar mais
        do que ajuda.
      </p>

      <div class="acoes no-print">
        <a class="btn btn--primary" href={acoes.compraCurso}>Quanto custa</a>
        <a class="btn btn--ghost" href="#a-grade">Conhecer a grade</a>
      </div>

      <p class="assinatura hand">
        Você escreve o que sabe. A IA dá forma. Você revisa e assina.
      </p>
    </div>

    <figure class="ilustracao" aria-labelledby="legenda-abertura">
      <div class="marginalia" aria-hidden="true">
        <span class="marginalia__seta">
          <Seta variante="curta" largura="80px" cor="var(--accent)" rotacao={112} />
        </span>
        <p class="marginalia__texto hand">
          num oceano de texto gerado por IA, isto aqui é o que tem valor
        </p>
      </div>

      <div class="postit">
        <p class="postit__rotulo mono">seu pedido, escrito por você</p>
        <p class="postit__texto">
          ETP para a compra de 12 estações de trabalho. Prazo de 90 dias. Orçamento em
          anexo. Precisa citar a Lei 14.133 e justificar o parcelamento.
        </p>
      </div>

      <div class="seta-vertical">
        <Seta variante="baixo" largura="26px" />
      </div>

      <div class="documento">
        <p class="documento__rotulo mono">o documento, com o que mudou à vista</p>
        <pre class="diff"><code><span class="ctx">1. DESCRIÇÃO DA NECESSIDADE</span>
<span class="del">- Aquisição de equipamentos de informática.</span>
<span class="add">+ Aquisição de 12 (doze) estações de trabalho,</span>
<span class="add">+ nos termos do art. 18 da Lei nº 14.133/2021.</span>
<span class="ctx">2. JUSTIFICATIVA DO PARCELAMENTO</span></code></pre>
      </div>

      <figcaption id="legenda-abertura" class="visually-hidden">
        Do pedido escrito à mão ao documento formal, com as alterações destacadas linha
        a linha.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .abertura {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5.5rem) clamp(3rem, 2rem + 5vw, 6rem);
  }

  .grade {
    display: grid;
    gap: clamp(2.5rem, 1rem + 6vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .grade {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  h1 {
    margin-bottom: 0.45em;
  }

  .lead {
    max-width: 34ch;
    font-size: 1.2em;
    color: var(--ink-2);
  }

  .para-quem {
    max-width: 42ch;
    color: var(--ink-2);
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-block: 1.8rem 1.4rem;
  }

  .assinatura {
    color: var(--accent);
    transform: rotate(-0.8deg);
    transform-origin: left;
    margin: 0;
  }

  /* ---------------- Ilustração ---------------- */

  .ilustracao {
    position: relative;
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 0.2rem;
  }

  .postit {
    background: var(--note);
    background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.4), rgba(0, 0, 0, 0.05));
    padding: 1.15rem 1.3rem 1.35rem;
    width: min(100%, 25rem);
    transform: rotate(-1.6deg);
    box-shadow:
      3px 4px 0 rgba(34, 31, 27, 0.1),
      0 16px 26px -18px rgba(34, 31, 27, 0.65);
  }

  .postit__rotulo {
    margin: 0 0 0.5rem;
    color: rgba(34, 31, 27, 0.6);
    text-transform: lowercase;
  }

  .postit__texto {
    font-family: var(--hand);
    font-size: 1.5rem;
    line-height: 1.3;
    margin: 0;
    color: var(--ink);
  }

  .seta-vertical {
    margin-block: 0.35rem;
  }

  .documento {
    width: min(100%, 27rem);
    background: var(--paper-soft);
    border: 2px solid var(--ink);
    border-radius: 3px;
    padding: 1.1rem 1.15rem 1.2rem;
    transform: rotate(0.7deg);
    box-shadow: 3px 4px 0 rgba(34, 31, 27, 0.12);
  }

  .documento__rotulo {
    margin: 0 0 0.6rem;
    color: var(--ink-3);
  }

  .diff {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.7;
    overflow-x: auto;
    white-space: pre;
  }

  .diff .ctx {
    color: var(--ink-3);
  }

  .diff .del {
    color: #8e3b2a;
    background: rgba(189, 79, 44, 0.12);
  }

  .diff .add {
    color: #2f6136;
    background: rgba(76, 125, 74, 0.15);
  }

  /* Aponta para o post-it, de cima. Fica acima dele para não separar o post-it
     da seta que desce até o documento: o pedido e o resultado ficam encadeados. */
  .marginalia {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    gap: 0;
    width: min(100%, 25rem);
    margin-block: 0 0.35rem;
    /* Desenha por cima do post-it: a ponta da seta encosta no papel. */
    position: relative;
    z-index: 1;
  }

  /* A seta está girada dentro da própria caixa, que continua com a largura do
     traço horizontal: as margens negativas descontam esse vazio lateral e
     encostam o traço no texto. */
  .marginalia__seta {
    margin-bottom: -1.1rem;
    margin-right: -1.5rem;
  }

  .marginalia__texto {
    max-width: 14rem;
    text-align: right;
    color: var(--accent);
    transform: rotate(-2deg);
    margin: 0;
  }

  @media (max-width: 48rem) {
    .marginalia {
      display: none;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
